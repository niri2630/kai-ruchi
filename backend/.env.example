# ---------------------------------------------------------------------------
# Kai Ruchi backend — copy to .env and fill in.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Postgres. Local install, or a hosted URL from Neon / Supabase / Railway.
# Neon looks like:
#   postgresql+psycopg2://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/kairuchi?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kairuchi

# Sign your own. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated. Add your Vercel URL once the frontend is deployed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay. Leave BOTH blank to run checkout in mock mode — the full flow still
# works, no gateway is contacted, and no card details are ever handled.
# Test keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR

# Storefront rules
FREE_SHIPPING_THRESHOLD=799
SHIPPING_FEE=59

# Demo fulfilment: minutes after payment at which the order advances to
# confirmed / packed / shipped / out-for-delivery / delivered.
AUTO_FULFILMENT=true
FULFILMENT_MINUTES=1,4,10,20,35
